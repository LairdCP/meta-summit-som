uuu_version 1.4.165

# The recovery initramfs must expose the fastboot-kernel (FBK) channel and
# provide the `fw_update` utility. This script boots the board into recovery,
# copies the SWU into RAM-backed storage, and applies it with a full-disk
# (`complete`) update, which matches the initramfs path used by this project.

# i.MX8MM / i.MX8MQ ROM entry.
SDPS: boot -f flash-rescue.bin

# Boot a temporary recovery Linux image. `download` only copies the FIT into
# DDR; U-Boot still needs an explicit boot command to start it.
FB: ucmd setenv fastboot_buffer ${loadaddr}
FB: download -f fitImage-rescue
FB: acmd bootm ${fastboot_buffer}
FB: done

# Stream the SWU payload over FBK file-upload and let the gadget side
# forward it directly into SWUpdate.
#FBK: ucp image-XYZ-weston-imxXXX-XYZ.swu  t:-
#FBK: done
