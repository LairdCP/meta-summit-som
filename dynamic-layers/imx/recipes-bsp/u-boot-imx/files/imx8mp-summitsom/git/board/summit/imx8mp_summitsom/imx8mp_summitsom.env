autoload=no
autostart=no
console=ttymxc1,115200
scriptaddr=0x43500000
fdt_addr=0x43000000
fdt_high=0xffffffffffffffff
bootm_size=0x10000000
splashimage=0x50000000

m7_bootaddr_itcm=0x7e0000
m7_bootaddr_ddr=0x80000000
m7_bootaddr_qspi=0x08000000
m7_ddr_temp=0x48000000

bootm7_itcm=
    imxtract ${loadaddr} firmware-1 ${m7_ddr_temp};
    cp.b ${m7_ddr_temp} ${m7_bootaddr_itcm} ${filesize};
    bootaux ${m7_bootaddr_itcm};
bootm7_ddr=
    imxtract ${loadaddr} firmware-1 ${m7_bootaddr_ddr};
    dcache flush;
    bootaux ${m7_bootaddr_ddr}
bootm7_qspi=
    sf probe;
    sf read ${m7_ddr_temp} 0 0x100000;
    bootaux ${m7_bootaddr_qspi}

conf=conf-imx8mp-summitsom-dvk-pcie-uart.dtb
loadimage=load mmc ${mmcdev}:${bootvol} ${loadaddr} fitImage
loadverity=load mmc ${mmcdev}:${bootvol} ${loadaddr} fitImageVerity.bin
loadm7=load mmc ${mmcdev}:${bootvol} ${loadaddr} fitImageMcu.bin

mmcside=
    if test ${bootside} = a; then
        setenv bootvol 1;
    else
        setenv bootvol 4;
    fi;
    if test ${boot_src} = sd; then
        setenv rootvol 5;
    else
        setexpr rootvol ${bootvol} + 1;
    fi

prepare_mcore=
    setexpr bootm7 sub m7-rpmsg '' ${conf};
    if test ${bootm7} != ${conf}; then
        setenv mcore_clk clk-imx8mp.mcore_booted;
    else
        setenv mcore_clk;
    fi

runm7=
    if test -n "${mcore_clk}"; then
        run loadm7 && run bootm7_itcm;
    fi

#ifdef CONFIG_SUMMIT_SECURE
mmcargs=
    setenv bootargs console=${console} ${mcore_clk} quiet
#else
mmcargs=
    setenv bootargs console=${console} ${mcore_clk}

mmcargs_trad=
    setenv bootargs console=${console} ${mcore_clk} quiet
    root=/dev/mmcblk${mmcdev}p${rootvol} rootwait rootfstype=ext4 rw
#endif

bootcmd=
    run prepare_mcore;
    run mmcside;
    run runm7;
    if test -e mmc "${mmcdev}:${bootvol}" fitImageVerity.bin; then
        run mmcargs;
        run loadverity && source ${loadaddr} || reset;
        run loadimage && bootm "${loadaddr}#${conf}" || reset;
#ifndef CONFIG_SUMMIT_SECURE
    elif test "${boot_src}" = sd; then
        run mmcargs_trad;
        run loadimage && bootm ${loadaddr}#${conf} || reset;
#endif
    else
        echo "No verity image found - halting!";
        reset;
    fi
